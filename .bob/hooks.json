{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*(write_to_file|write_file|replace_file_content|multi_replace_file_content|apply_diff|edit_file|new_empty_file|create_file|patch).*",
        "hooks": [
          {
            "type": "command",
            "command": "sh .bob/hooks/gate-fix.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*(execute_command|run_command|terminal).*",
        "hooks": [
          {
            "type": "command",
            "command": "sh .bob/hooks/record-verdict.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
